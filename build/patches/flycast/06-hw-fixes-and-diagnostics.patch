 {
+#if defined(__EMSCRIPTEN__) && !defined(JIT_PROD_BUILD)
+	{
+		extern u32 g_fly_ack[8];
+		if (data & (1u << 19)) ((SB_ISTNRM & (1u << 19)) ? g_fly_ack[1] : g_fly_ack[2])++;
+		if (data & (1u << 7))  ((SB_ISTNRM & (1u << 7))  ? g_fly_ack[4] : g_fly_ack[5])++;
