+#[unsafe(no_mangle)]
+pub extern "C" fn retro_set_environment(cb: RetroEnvironmentFn) {
+    CALLBACKS.get().environment = Some(cb);
+    let mut no_game = false;
+    environment(RETRO_ENVIRONMENT_SET_SUPPORT_NO_GAME, (&raw mut no_game).cast());
+    options::register();
+}
