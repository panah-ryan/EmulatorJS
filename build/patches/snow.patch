+//! Core options, read when a game is loaded
+
+use std::ffi::{CStr, CString, c_char};
+use std::sync::OnceLock;
+
+use snow_core::mac::{MacModel, MacMonitor};
+use strum::IntoEnumIterator;
+
+use crate::environment;
+use crate::retro::*;
+
+const MODEL_KEY: &CStr = c"snow_model";
+const MONITOR_KEY: &CStr = c"snow_monitor";
+
+const AUTO: &str = "Auto";
+
+struct Definitions {
+    model: CString,
+    monitor: CString,
+}
+
+static DEFINITIONS: OnceLock<Definitions> = OnceLock::new();
+
+fn definitions() -> &'static Definitions {
+    DEFINITIONS.get_or_init(|| {
+        let models = std::iter::once(AUTO.to_string())
+            .chain(MacModel::iter().map(|m| m.to_string()))
+            .collect::<Vec<_>>()
+            .join("|");
+        // The first value is the default
+        let monitors = std::iter::once(MacMonitor::default())
+            .chain(MacMonitor::iter().filter(|m| *m != MacMonitor::default()))
+            .map(|m| m.to_string())
+            .collect::<Vec<_>>()
+            .join("|");
+        Definitions {
+            model: CString::new(format!("Model (restart); {models}")).unwrap(),
+            monitor: CString::new(format!("Monitor, Display Card 8-24 only (restart); {monitors}"))
+                .unwrap(),
+        }
+    })
+}
+
+pub fn register() {
+    let defs = definitions();
+    let mut vars = [
+        RetroVariable {
+            key: MODEL_KEY.as_ptr(),
+            value: defs.model.as_ptr(),
+        },
+        RetroVariable {
+            key: MONITOR_KEY.as_ptr(),
+            value: defs.monitor.as_ptr(),
+        },
+        RetroVariable {
+            key: std::ptr::null(),
+            value: std::ptr::null(),
+        },
+    ];
+    environment(RETRO_ENVIRONMENT_SET_VARIABLES, vars.as_mut_ptr().cast());
+}
+
+fn get(key: &CStr) -> Option<String> {
+    let mut var = RetroVariable {
+        key: key.as_ptr(),
+        value: std::ptr::null::<c_char>(),
+    };
+    if !environment(RETRO_ENVIRONMENT_GET_VARIABLE, (&raw mut var).cast()) || var.value.is_null() {
+        return None;
+    }
+    Some(unsafe { CStr::from_ptr(var.value) }.to_string_lossy().into_owned())
+}
+
+/// The model to emulate, or None to pick it from the ROMs
+pub fn model() -> Option<MacModel> {
+    let value = get(MODEL_KEY)?;
+    MacModel::iter().find(|m| m.to_string() == value)
+}
+
+pub fn monitor() -> MacMonitor {
+    get(MONITOR_KEY)
+        .and_then(|value| MacMonitor::iter().find(|m| m.to_string() == value))
+        .unwrap_or_default()
+}
