+        let _ = core.cmd.send(EmulatorCommand::Reset);
+    }
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn retro_run() {
+    if let Some(poll) = CALLBACKS.get().input_poll {
+        unsafe { poll() };
+    }
+    let Some(core) = CORE.get().as_mut() else {
+        return;
+    };
+    core.poll_input();
+    match core.run_frame() {
+        Ok(Some(frame)) => core.present(&frame),
+        Ok(None) => warn!("No frame produced"),
+        Err(e) => error!("Emulator error: {:?}", e),
+    }
+    core.flush_audio();
+}
+
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn retro_load_game(game: *const RetroGameInfo) -> bool {
+    let mut format = RETRO_PIXEL_FORMAT_XRGB8888;
+    if !environment(RETRO_ENVIRONMENT_SET_PIXEL_FORMAT, (&raw mut format).cast()) {
+        error!("XRGB8888 is not supported");
+        return false;
+    }
+
+    if game.is_null() || unsafe { (*game).path.is_null() } {
+        error!("No game path provided");
+        return false;
+    }
+    let path = PathBuf::from(unsafe { CStr::from_ptr((*game).path) }.to_string_lossy().into_owned());
+
+    match Core::new(&path) {
+        Ok(core) => {
+            *CORE.get() = Some(core);
+            let mut kb = RetroKeyboardCallback {
+                callback: keyboard_event,
+            };
+            environment(RETRO_ENVIRONMENT_SET_KEYBOARD_CALLBACK, (&raw mut kb).cast());
+            true
+        }
+        Err(e) => {
+            error!("Failed to start: {:?}", e);
+            false
+        }
+    }
+}
+
+#[unsafe(no_mangle)]
