diff --git a/Makefile.common b/Makefile.common
index bc4be88..a87ac2a 100644
--- a/Makefile.common
+++ b/Makefile.common
@@ -165,6 +165,15 @@ SOURCES_C += 	 $(LIBRETRO_COMM_DIR)/formats/mpeg1/rmpeg1_ps.c \
 
 endif
 
+# EmulatorJS links statically against an older libretro-common that lacks the
+# MPEG-1/MP3 decoders and filestream_get_mapped_ptr, so build those here
+ifeq ($(platform), emscripten)
+SOURCES_C += 	 $(LIBRETRO_COMM_DIR)/formats/mpeg1/rmpeg1_ps.c \
+		 $(LIBRETRO_COMM_DIR)/formats/mpeg1/rmpeg1_video.c \
+		 $(LIBRETRO_COMM_DIR)/formats/mp3/rmp3.c \
+		 $(CORE_DIR)/emscripten_compat.c
+endif
+
 ifeq ($(NEED_THREADING), 1)
 SOURCES_C +=	 $(LIBRETRO_COMM_DIR)/rthreads/rthreads.c \
                  $(LIBRETRO_COMM_DIR)/queues/retro_spsc.c \
diff --git a/emscripten_compat.c b/emscripten_compat.c
new file mode 100644
index 0000000..68bb123
--- /dev/null
+++ b/emscripten_compat.c
@@ -0,0 +1,13 @@
+#include <stddef.h>
+#include <streams/file_stream.h>
+
+/* Fallback for frontends whose libretro-common predates
+ * filestream_get_mapped_ptr.  Weak, so a frontend that has it wins.
+ * Every caller treats NULL as "no mapping" and reads the file instead. */
+__attribute__((weak)) const uint8_t *filestream_get_mapped_ptr(RFILE *stream, int64_t *len)
+{
+   (void)stream;
+   if (len)
+      *len = 0;
+   return NULL;
+}
diff --git a/libretro-common/encodings/encoding_crc32.c b/libretro-common/encodings/encoding_crc32.c
index 530c16e..cb933f1 100644
--- a/libretro-common/encodings/encoding_crc32.c
+++ b/libretro-common/encodings/encoding_crc32.c
@@ -450,6 +450,10 @@ uint32_t encoding_crc32_ogg(uint32_t crc, const uint8_t *data, size_t len)
    return crc;
 }
 
+/* statically linked frontends (e.g. EmulatorJS) already provide
+ * encoding_crc32 from their own libretro-common; defining it here too
+ * collides once this object is pulled in for the ogg/crc16 variants */
+#ifndef STATIC_LINKING
 uint32_t encoding_crc32(uint32_t crc, const uint8_t *data, size_t len)
 {
    crc = ~crc;
@@ -472,3 +476,4 @@ uint32_t encoding_crc32(uint32_t crc, const uint8_t *data, size_t len)
 
    return ~crc;
 }
+#endif
