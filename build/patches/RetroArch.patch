diff --git a/emulatorjs/build-emulatorjs.sh b/emulatorjs/build-emulatorjs.sh
index 3c05ecf..67570e2 100755
--- a/emulatorjs/build-emulatorjs.sh
+++ b/emulatorjs/build-emulatorjs.sh
@@ -63,13 +63,13 @@ lastGles=0
 
 largeStack=("mupen64plus_next" "azahar")
 useOpenAL=()
-largeHeap=("mupen64plus_next" "picodrive" "pcsx_rearmed" "genesis_plus_gx" "genesis_plus_gx_wide" "mednafen_psx" "mednafen_psx_hw" "parallel_n64" "ppsspp" "azahar")
-needsGles3=("ppsspp" "azahar")
-needsThreads=("ppsspp" "azahar")
-largeThreads=("ppsspp" "azahar")
-noCHD=("mame2003" "mame2003_plus" "pcsx_rearmed" "genesis_plus_gx" "genesis_plus_gx_wide" "azahar")
-no7Zip=("bsnes")
-needsAsync=("mupen64plus_next" "dosbox_pure" "ppsspp" "azahar" "bsnes" "bluemsx" "scummvm")
+largeHeap=("flycast" "mupen64plus_next" "picodrive" "pcsx_rearmed" "swanstation" "genesis_plus_gx" "genesis_plus_gx_wide" "mednafen_psx" "mednafen_psx_hw" "parallel_n64" "ppsspp" "azahar" "xemu" "tabstationtoo")
+needsGles3=("ppsspp" "azahar" "flycast")
+needsThreads=("ppsspp" "azahar" "xemu" "tabstationtoo")
+largeThreads=("ppsspp" "azahar" "xemu" "tabstationtoo")
+noCHD=("mame2003" "mame2003_plus" "pcsx_rearmed" "swanstation" "genesis_plus_gx" "genesis_plus_gx_wide" "azahar" "geartowns" "virtualjaguar" "emir" "flycast" "ppsspp" "tabstationtoo")
+no7Zip=("bsnes" "tabstationtoo")
+needsAsync=("mupen64plus_next" "dosbox_pure" "azahar" "bsnes" "bluemsx" "scummvm" "xemu")
 
 for f in $(ls -v *_emscripten.bc); do
   name=`echo "$f" | sed "s/\(_libretro_emscripten\|\).bc$//"`
@@ -84,6 +84,8 @@ for f in $(ls -v *_emscripten.bc); do
   threads=0
   have_al=0
   have_rwebaudio=1
+  core_cflags=""
+  core_ldflags=""
 
   if [ "$LEGACY" = "YES" ]; then
     gles3=0
@@ -120,6 +122,23 @@ for f in $(ls -v *_emscripten.bc); do
   if [[ $(containsElement $name "${needsAsync[@]}") = 1 ]]; then
     async=1
   fi
+  # xemu's coroutines suspend through xemu_co_suspend and its JIT adds compiled
+  # blocks to the table. Only code running inside a coroutine is ever unwound,
+  # so the CPU, GPU, audio and device hot paths are left uninstrumented.
+  if [ $name = "xemu" ]; then
+    xemu_asyncify_remove="cpu_exec*,cpu_tb_exec,cpu_loop_*,tcg_*,tci_*,tb_*,tlb_*,helper_*,x86_*,gen_*,disas_*,i386_*,translator_*,float16_*,float32_*,float64_*,floatx80_*,float128_*,parts64_*,parts128_*,softfloat_*,round_*,memory_region_*,address_space_*,flatview_*,io_readx,io_writex,probe_access*,get_page_addr_code*,mmu_*,pgraph_*,nv2a_*,pfifo_*,pcrtc_*,pramdac_*,pvideo_*,ptimer_*,pmc_*,pbus_*,prmcio_*,vga_*,gl*,xemu_gl*,mcpx_*,dsp_*,vp_*,voice_*,se_*,fe_*,hrtf_*,usb_*,ohci_*,xid_*,pci_*,apic_*,pic_*,ioapic_*,smbus_*,lpc_*,xbox_*,unswizzle_*,swizzle_*,s3tc_*,mstring_*,lru_*,fast_hash*,XXH*"
+    core_ldflags="-sASYNCIFY_IMPORTS=ffi_call_js,xemu_co_suspend -sALLOW_TABLE_GROWTH=1 -sASYNCIFY_REMOVE='$xemu_asyncify_remove'"
+  fi
+  # TabStationToo (PS2): PCSX2 uses wasm setjmp/longjmp, which RetroArch is then compiled with too; it keeps
+  # its memory under 2 GB, as TabStationToo does (addresses above crash its JIT code); its JIT
+  # adds compiled blocks to the table; its threads need more than the default stack; its GS thread waits for
+  # WebGPU with JSPI, whose stand-in (a pre-js) lets browsers without it start on the software renderer; and the
+  # JIT runtime and WebGPU host are JS libraries in the core's checkout (build/compile/tabstationtoo, next to
+  # RetroArch).
+  if [ $name = "tabstationtoo" ]; then
+    core_cflags="-sSUPPORT_LONGJMP=wasm"
+    core_ldflags="-sSUPPORT_LONGJMP=wasm -sMAXIMUM_MEMORY=2GB -sALLOW_TABLE_GROWTH=1 -sDEFAULT_PTHREAD_STACK_SIZE=2MB -sJSPI --pre-js=../tabstationtoo/pcsx2-wasm/jspi-fallback.js --use-port=emdawnwebgpu --js-library=../tabstationtoo/pcsx2/wasm/WasmJitRuntime.js --js-library=../tabstationtoo/pcsx2/GS/Renderers/WebGPU/webgpu_host.js"
+  fi
   if [[ $(containsElement $name "${needsGles3[@]}") = 1 && $gles3 = 0 ]]; then
     echo "$name"' does not support gles2 (legacy)! Please build without --legacy! Exiting...'
     exit 1
@@ -151,8 +170,8 @@ for f in $(ls -v *_emscripten.bc); do
   fi
 
   # Compile core
-  echo "BUILD COMMAND: make -C ../ -f Makefile.emulatorjs HAVE_7ZIP=$sevenZip HAVE_CHD=$chd HAVE_THREADS=$threads PTHREAD_POOL_SIZE=$pthread ASYNC=$async HAVE_OPENGLES3=$gles3 STACK_SIZE=$stack_mem INITIAL_HEAP=$heap_mem HAVE_AL=$have_al HAVE_RWEBAUDIO=$have_rwebaudio LIGHT_DEBUG=$light_debug TARGET=${name}_libretro.js -j"$(nproc)
-  make -C ../ -f Makefile.emulatorjs HAVE_7ZIP=$sevenZip HAVE_CHD=$chd HAVE_THREADS=$threads PTHREAD_POOL_SIZE=$pthread ASYNC=$async HAVE_OPENGLES3=$gles3 STACK_SIZE=$stack_mem INITIAL_HEAP=$heap_mem HAVE_AL=$have_al HAVE_RWEBAUDIO=$have_rwebaudio LIGHT_DEBUG=$light_debug TARGET=${name}_libretro.js -j$(nproc) || exit 1
+  echo "BUILD COMMAND: make -C ../ -f Makefile.emulatorjs HAVE_7ZIP=$sevenZip HAVE_CHD=$chd HAVE_THREADS=$threads PTHREAD_POOL_SIZE=$pthread ASYNC=$async HAVE_OPENGLES3=$gles3 STACK_SIZE=$stack_mem INITIAL_HEAP=$heap_mem HAVE_AL=$have_al HAVE_RWEBAUDIO=$have_rwebaudio LIGHT_DEBUG=$light_debug CORE_CFLAGS=\"$core_cflags\" CORE_LDFLAGS=\"$core_ldflags\" TARGET=${name}_libretro.js -j"$(nproc)
+  make -C ../ -f Makefile.emulatorjs HAVE_7ZIP=$sevenZip HAVE_CHD=$chd HAVE_THREADS=$threads PTHREAD_POOL_SIZE=$pthread ASYNC=$async HAVE_OPENGLES3=$gles3 STACK_SIZE=$stack_mem INITIAL_HEAP=$heap_mem HAVE_AL=$have_al HAVE_RWEBAUDIO=$have_rwebaudio LIGHT_DEBUG=$light_debug CORE_CFLAGS="$core_cflags" CORE_LDFLAGS="$core_ldflags" TARGET=${name}_libretro.js -j$(nproc) || exit 1
 
   # Move executable files
   out_dir="../../EmulatorJS/data/cores"
