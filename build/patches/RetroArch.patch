 HAVE_CHD ?= 0
 HAVE_NETPLAYDISCOVERY ?= 0
 
@@ -104,6 +108,10 @@ PTHREAD_POOL_SIZE ?= 4
 ASYNCIFY_ADD ?= dynCall_*,emscripten_mainloop
 ASYNCIFY_REMOVE ?= threaded_worker
 
+# compile and link flags a single core needs (see emulatorjs/build-emulatorjs.sh)
+CORE_CFLAGS ?=
+CORE_LDFLAGS ?=
+
 STACK_SIZE ?= 4194304
 INITIAL_HEAP ?= 134217728
 
@@ -129,7 +137,7 @@ EXPORTED_FUNCTIONS = _main,_malloc,_free,_load_state, \
                      _set_vsync,_set_video_rotation,_get_video_dimensions,EmscriptenSendCommand,EmscriptenReceiveCommandReply,_get_memory_data, \
                      _ejs_set_controller_port_device,_ejs_get_controller_port_info
 
-EXPORTS := Browser,callMain,cwrap,getValue,HEAPU8,FS,PATH,ERRNO_CODES,AL,abort,ENV,stringToNewUTF8,UTF8ToString,Browser,EmscriptenSendCommand,EmscriptenReceiveCommandReply,EmulatorJSGetState,EmulatorJSGetMemoryData
+EXPORTS := Browser,callMain,cwrap,getValue,HEAPU8,FS,PATH,ERRNO_CODES,AL,abort,ENV,stringToNewUTF8,UTF8ToString,Browser,EmscriptenSendCommand,EmscriptenReceiveCommandReply,EmulatorJSGetState,EmulatorJSGetMemoryData,IDBFS
 
 LIBS   := -s USE_ZLIB=1
 CFLAGS := -s USE_ZLIB=1
@@ -168,6 +176,7 @@ LDFLAGS := -L. $(LIBS) -s STACK_SIZE=$(STACK_SIZE) -s INITIAL_MEMORY=$(INITIAL_H
            -s EXPORTED_RUNTIME_METHODS=$(EXPORTS) \
            -s ALLOW_MEMORY_GROWTH=1 -s EXPORTED_FUNCTIONS="$(EXPORTED_FUNCTIONS)" \
            -s ERROR_ON_UNDEFINED_SYMBOLS=0 \
+           -s DEFAULT_TO_CXX=1 \
            -lidbfs.js \
            -s MODULARIZE=1 -s EXPORT_NAME="EJS_Runtime" \
            -s ENVIRONMENT=web,worker -s WASM_BIGINT=1 \
@@ -277,16 +286,16 @@ endif
 
 include Makefile.common
 
+LDFLAGS += $(CORE_LDFLAGS)
+CFLAGS += $(CORE_CFLAGS)
+CXXFLAGS += $(CORE_CFLAGS)
+
 CFLAGS += $(DEF_FLAGS) -Ideps -Ideps/stb
 
 libretro     =
 libretro_new =
 additional_libs =
 
-ifneq (,$(findstring ppsspp,$(TARGET)))
-  additional_libs = ffmpeg/libavcodec.a ffmpeg/libavformat.a ffmpeg/libavutil.a ffmpeg/libswresample.a ffmpeg/libswscale.a
-endif
-
 ifeq ($(HAVE_STATIC_DUMMY),1)
   DEFINES += -DHAVE_STATIC_DUMMY
