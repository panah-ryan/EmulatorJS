diff --git a/Makefile.emulatorjs b/Makefile.emulatorjs
index b5862b3..6311e48 100644
--- a/Makefile.emulatorjs
+++ b/Makefile.emulatorjs
@@ -52,6 +52,10 @@ HAVE_IBXM = 1
 HAVE_CORE_INFO_CACHE = 1
 HAVE_7ZIP = 1
 HAVE_BSV_MOVIE = 1
+# Emscripten's libc has getopt_long. RetroArch's own copy defines optind and
+# the other getopt globals, which clash with libc's for a core using getopt.
+HAVE_GETOPT_LONG = 1
