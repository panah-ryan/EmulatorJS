+/* describes each DIP switch of the driver's input ports as a core option */
+static void build_dip_switch_options(void)
+{
+  struct InputPort *base, *in;
+
+  dip_switch_count = 0;
+  memset(dip_switch_options, 0, sizeof(dip_switch_options));
+  if(!game_driver->input_ports)
+    return;
+
+  base = input_port_allocate(game_driver->input_ports);
+  for(in = base; in->type != IPT_END && dip_switch_count < DIP_SWITCH_SLOTS; in++)
+  {
+    struct retro_core_option_v2_definition *option = &dip_switch_options[dip_switch_count];
+    const struct InputPort *setting;
+    const char *name;
+    int count = 0;
+
+    if((in->type & ~IPF_MASK) != IPT_DIPSWITCH_NAME || (in->type & (IPF_UNUSED | IPF_CHEAT)))
+      continue;
+    name = input_port_name(in);
+    if(!name || !name[0])
+      continue;
+
+    for(setting = in + 1; (setting->type & ~IPF_MASK) == IPT_DIPSWITCH_SETTING && count < RETRO_NUM_CORE_OPTION_VALUES_MAX - 1; setting++)
+    {
+      char value[12];
+      int i, duplicate = 0;
+
+      if(setting->type & (IPF_UNUSED | IPF_CHEAT))
+        continue;
+      sprintf(value, "dip%u", setting->default_value & in->mask);
+      for(i = 0; i < count; i++)
+        duplicate |= !strcmp(dip_switch_values[dip_switch_count][i], value);
+      if(duplicate)
+        continue;
+      strcpy(dip_switch_values[dip_switch_count][count], value);
+      option->values[count].value = dip_switch_values[dip_switch_count][count];
+      option->values[count].label = input_port_name(setting);
+      count++;
+    }
+    if(count < 2)
+      continue;
+
+    snprintf(dip_switch_keys[dip_switch_count], sizeof(dip_switch_keys[0]), APPNAME"_%.16s_dip_%d", game_driver->name, dip_switch_count + 1);
+    snprintf(dip_switch_labels[dip_switch_count], sizeof(dip_switch_labels[0]), "DIP: %s", name);
+    sprintf(dip_switch_values[dip_switch_count][RETRO_NUM_CORE_OPTION_VALUES_MAX - 1], "dip%u", in->default_value & in->mask);
+    option->key = dip_switch_keys[dip_switch_count];
+    option->desc = dip_switch_labels[dip_switch_count];
+    option->info = "Changes one of the game's DIP switches. Some only take effect after a restart.";
+    option->default_value = dip_switch_values[dip_switch_count][RETRO_NUM_CORE_OPTION_VALUES_MAX - 1];
+    dip_switch_entries[dip_switch_count] = in - base;
+    dip_switch_masks[dip_switch_count] = in->mask;
+    dip_switch_count++;
+  }
+  input_port_free(base);
+}
+
+static void apply_dip_switch(int slot, const char *value)
+{
+  struct InputPort *in;
+
+  if(!Machine->input_ports || strncmp(value, "dip", 3))
+    return;
+  in = &Machine->input_ports[dip_switch_entries[slot]];
+  in->default_value = (in->default_value & ~dip_switch_masks[slot]) | (atoi(value + 3) & dip_switch_masks[slot]);
+}
+
+/* the saved settings of the core options override the machine's own config */
+void apply_dip_switch_options(void)
+{
+  struct retro_variable var;
+  int slot;
+
+  for(slot = 0; slot < dip_switch_count; slot++)
+  {
+    var.value = NULL;
+    var.key = default_options[OPT_DIP_SWITCH + slot].key;
+    if(environ_cb(RETRO_ENVIRONMENT_GET_VARIABLE, &var) && !string_is_empty(var.value))
+      apply_dip_switch(slot, var.value);
+  }
+}
