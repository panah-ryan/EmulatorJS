Puts snow_core's serial (PTY/TCP) and LocalTalk-over-UDP host bridges behind a
"host_bridges" feature. It is on by default, so desktop snow is unchanged; the
libretro core turns it off, which keeps socket2 and nix out of the wasm build.

diff --git a/core/Cargo.toml b/core/Cargo.toml
index cab650e..8c9d8ee 100644
--- a/core/Cargo.toml
+++ b/core/Cargo.toml
@@ -8,6 +8,9 @@ build = "build.rs"
 built = { version = "0.8.0", features = ["chrono", "git2"] }
 
 [features]
+default = ["host_bridges"]
+# Enables serial (PTY/TCP) and LocalTalk-over-UDP bridges to the host
+host_bridges = ["dep:socket2", "dep:nix"]
 # Enables the Daynaport SCSI/Link Ethernet device emulation
 ethernet = ["dep:crc", "dep:binrw"]
 # Enables Ethernet bridging (currently broken!)
@@ -71,13 +74,13 @@ unicode-normalization = "0.1.24"
 postcard = { version = "1.1.3", features = ["use-std"], optional = true }
 binrw = { version = "0.15.0", optional = true }
 zstd = { version = "0.13.3", optional = true }
-socket2 = { version = "0.6", features = ["all"] }
+socket2 = { version = "0.6", features = ["all"], optional = true }
 pnet = { version = "0.35.0", optional = true }
 tun = { version = "0.7", optional = true, default-features = false }
 image = { version = "0.25", default-features = false, features = ["png"], optional = true }
 
 [target.'cfg(unix)'.dependencies]
-nix = { version = "0.29", features = ["term", "fs"] }
+nix = { version = "0.29", features = ["term", "fs"], optional = true }
 
 [target.'cfg(windows)'.dependencies]
 windows = {
