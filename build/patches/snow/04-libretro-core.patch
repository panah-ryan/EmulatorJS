+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn retro_get_system_info(info: *mut RetroSystemInfo) {
+    unsafe {
+        *info = RetroSystemInfo {
+            library_name: c"Snow".as_ptr(),
+            library_version: c"0.1.0".as_ptr(),
+            valid_extensions: c"dsk|img|image|dc42|moof|woz|a2r|raw|hda|hdv|sit".as_ptr(),
+            need_fullpath: true,
+            block_extract: false,
+        };
+    }
+}
+
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn retro_get_system_av_info(info: *mut RetroSystemAvInfo) {
+    let core = CORE.get().as_ref();
+    let (width, height) = match core {
+        Some(core) if core.width > 0 => (core.width, core.height),
+        _ => (512, 342),
+    };
+    let (fps, sample_rate) = core.map_or((DEFAULT_FPS, DEFAULT_SAMPLE_RATE), |c| timing(c.model));
+    unsafe {
+        *info = RetroSystemAvInfo {
+            geometry: geometry(width, height),
+            timing: RetroSystemTiming { fps, sample_rate },
+        };
+    }
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn retro_set_controller_port_device(_port: u32, _device: u32) {}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn retro_reset() {
+    if let Some(core) = CORE.get().as_ref() {
+        let _ = core.cmd.send(EmulatorCommand::Reset);
+    }
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn retro_run() {
+    if let Some(poll) = CALLBACKS.get().input_poll {
+        unsafe { poll() };
+    }
+    let Some(core) = CORE.get().as_mut() else {
+        return;
+    };
+    core.poll_input();
+    match core.run_frame() {
+        Ok(Some(frame)) => core.present(&frame),
+        Ok(None) => warn!("No frame produced"),
+        Err(e) => error!("Emulator error: {:?}", e),
+    }
+    core.flush_audio();
+}
+
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn retro_load_game(game: *const RetroGameInfo) -> bool {
+    let mut format = RETRO_PIXEL_FORMAT_XRGB8888;
+    if !environment(RETRO_ENVIRONMENT_SET_PIXEL_FORMAT, (&raw mut format).cast()) {
+        error!("XRGB8888 is not supported");
+        return false;
+    }
+
+    if game.is_null() || unsafe { (*game).path.is_null() } {
+        error!("No game path provided");
+        return false;
+    }
+    let path = PathBuf::from(unsafe { CStr::from_ptr((*game).path) }.to_string_lossy().into_owned());
+
+    match Core::new(&path) {
+        Ok(core) => {
+            *CORE.get() = Some(core);
+            let mut kb = RetroKeyboardCallback {
+                callback: keyboard_event,
+            };
+            environment(RETRO_ENVIRONMENT_SET_KEYBOARD_CALLBACK, (&raw mut kb).cast());
+            true
+        }
+        Err(e) => {
+            error!("Failed to start: {:?}", e);
+            false
+        }
+    }
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn retro_load_game_special(_type: u32, _info: *const RetroGameInfo, _num: usize) -> bool {
+    false
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn retro_unload_game() {
+    *CORE.get() = None;
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn retro_get_region() -> u32 {
+    RETRO_REGION_NTSC
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn retro_serialize_size() -> usize {
+    0
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn retro_serialize(_data: *mut c_void, _size: usize) -> bool {
+    false
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn retro_unserialize(_data: *const c_void, _size: usize) -> bool {
+    false
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn retro_cheat_reset() {}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn retro_cheat_set(_index: u32, _enabled: bool, _code: *const c_char) {}
+
+/// PRAM is the save RAM, so settings such as the colour depth survive a restart
+fn save_ram(id: u32) -> Option<&'static mut [u8]> {
+    if id != RETRO_MEMORY_SAVE_RAM {
+        return None;
+    }
+    CORE.get().as_mut().map(|core| core.emulator.pram_mut())
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn retro_get_memory_data(id: u32) -> *mut c_void {
+    save_ram(id).map_or(std::ptr::null_mut(), |pram| pram.as_mut_ptr().cast())
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn retro_get_memory_size(id: u32) -> usize {
+    save_ram(id).map_or(0, |pram| pram.len())
+}
