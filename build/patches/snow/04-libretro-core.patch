+/// Compact Macs: one audio sample per scanline, 352 CPU cycles per line, 370 lines per frame
+const COMPACT_CLOCK: f64 = 7_833_600.0;
+const COMPACT_SAMPLE_RATE: f64 = COMPACT_CLOCK / 352.0;
+const COMPACT_FPS: f64 = COMPACT_CLOCK / (352.0 * 370.0);
+
+/// Mac II family: video cards interrupt at the bus clock / 60, the ASC samples every 704 C16M cycles
+const MACII_SAMPLE_RATE: f64 = 15_667_200.0 / 704.0;
+const MACII_FPS: f64 = 60.0;
+
+const DEFAULT_SAMPLE_RATE: f64 = 22050.0;
+const DEFAULT_FPS: f64 = 60.15;
+
+const MDC12_ROM_SHA256: &str = "e2e763a6b432c9196f619a9f90107726ab1a84a1d54242fe5f5182bf3c97b238";
+const TOBY_ROM_SHA256: &str = "02261d5b8739352ead945de0fdccd3a364890fb67d75eb5449e4bd19e18c06fc";
+const SE30_VIDEO_ROM_SHA256: &str = "8af892fd7fff89c2151bb3027f3dc61e531f24e4adb0e3face95c90daece4409";
+
+/// Largest file considered when looking for ROMs
+const MAX_ROM_SIZE: u64 = 1024 * 1024;
+
+const MAX_WIDTH: u32 = 1152;
+const MAX_HEIGHT: u32 = 870;
+
+/// Steps per emulator tick, well below the fewest instructions in a frame so
+/// that no tick spans two frames
+const STEP_BATCH: usize = 1000;
+
+/// How long after start a floppy ejected by the ROM is put back, for a hard disk boot
+const BOOT_EJECT_WINDOW_FRAMES: u32 = 60 * 60;
+/// Delay before putting it back, so the ROM has moved on to the hard disk
+const REINSERT_DELAY_FRAMES: u32 = 2 * 60;
+
+/// Upper bound of emulator ticks per retro_run, in case no frame is produced
+const MAX_TICKS_PER_RUN: usize = 4000;
+
+const FLOPPY_EXTENSIONS: &[&str] = &["dsk", "img", "image", "dc42", "moof", "woz", "a2r", "raw"];
+const HDD_EXTENSIONS: &[&str] = &["hda", "hdv"];
+const ARCHIVE_EXTENSIONS: &[&str] = &["sit"];
+
+/// Holds state for libretro's single-threaded calls
+struct Global<T>(UnsafeCell<T>);
+
+unsafe impl<T> Sync for Global<T> {}
+
+impl<T> Global<T> {
+    const fn new(v: T) -> Self {
+        Self(UnsafeCell::new(v))
+    }
+
+    #[allow(clippy::mut_from_ref)]
+    fn get(&self) -> &mut T {
+        unsafe { &mut *self.0.get() }
+    }
+}
+
+#[derive(Default)]
+struct Callbacks {
+    environment: Option<RetroEnvironmentFn>,
+    video: Option<RetroVideoRefreshFn>,
+    audio_batch: Option<RetroAudioSampleBatchFn>,
+    input_poll: Option<RetroInputPollFn>,
+    input_state: Option<RetroInputStateFn>,
+    log: Option<RetroLogPrintfFn>,
+}
+
+static CALLBACKS: Global<Callbacks> = Global::new(Callbacks {
+    environment: None,
+    video: None,
+    audio_batch: None,
+    input_poll: None,
+    input_state: None,
+    log: None,
+});
+
+static CORE: Global<Option<Core>> = Global::new(None);
+
+fn environment(cmd: u32, data: *mut c_void) -> bool {
+    match CALLBACKS.get().environment {
+        Some(f) => unsafe { f(cmd, data) },
+        None => false,
+    }
+}
+
+/// Collects produced audio without ever blocking the emulator
+#[derive(Clone, Default)]
+struct BufferAudioSink(Arc<Mutex<Vec<f32>>>);
+
+impl AudioSink for BufferAudioSink {
+    fn send(&self, buffer: AudioBuffer) -> Result<()> {
+        self.0.lock().unwrap().extend_from_slice(&buffer);
+        Ok(())
+    }
+
+    fn is_full(&self) -> bool {
+        false
+    }
+
+    fn is_empty(&self) -> bool {
+        self.0.lock().unwrap().is_empty()
+    }
+}
+
+struct BufferAudioProvider(BufferAudioSink);
+
+impl AudioProvider for BufferAudioProvider {
+    fn create_stream(&mut self, _freq: i32, _channels: u8, _samples: u16) -> Result<Box<dyn AudioSink>> {
+        Ok(Box::new(self.0.clone()))
+    }
+}
+
+/// Video and audio rates of a model, as (fps, sample rate)
+fn timing(model: MacModel) -> (f64, f64) {
+    match model {
+        MacModel::Early128K
+        | MacModel::Early512K
+        | MacModel::Early512Ke
+        | MacModel::Plus
+        | MacModel::SE
+        | MacModel::SeFdhd
+        | MacModel::Classic => (COMPACT_FPS, COMPACT_SAMPLE_RATE),
+        MacModel::MacII
+        | MacModel::MacIIFDHD
+        | MacModel::MacIIx
+        | MacModel::MacIIcx
+        | MacModel::SE30 => (MACII_FPS, MACII_SAMPLE_RATE),
+        _ => (DEFAULT_FPS, DEFAULT_SAMPLE_RATE),
+    }
+}
+
+struct Core {
+    emulator: Emulator,
+    cmd: EmulatorCommandSender,
+    events: EmulatorEventReceiver,
+    model: MacModel,
+    frame_recv: Arc<Mutex<Option<DisplayBuffer>>>,
+    audio: BufferAudioSink,
+    video_buf: Vec<u32>,
+    audio_buf: Vec<i16>,
+    width: u32,
+    height: u32,
+    mouse_button: bool,
+    frames: u32,
+    /// Whether the game floppy goes back in after the ROM ejects it while starting up
+    reinsert_floppy: bool,
+    /// A floppy to insert, and the frames to wait before doing so
+    pending_floppy: Option<(u32, EmulatorCommand)>,
+}
+
+impl Core {
+    fn new(game_path: &Path) -> Result<Self> {
+        let system = SystemFiles::find(game_path);
+        let rom = system.main.as_deref().context("No supported Macintosh ROM found")?;
+        let model = select_model(rom, &system)?;
+        info!("Model: {}", model);
+
+        let mut extra_roms = Vec::new();
+        let mut monitor = None;
+        match model {
+            MacModel::SE30 => extra_roms.push(ExtraROMs::SE30Video(
+                system.se30_video.as_deref().context("The SE/30 needs its video ROM")?,
+            )),
+            MacModel::MacII | MacModel::MacIIFDHD | MacModel::MacIIx | MacModel::MacIIcx => {
+                if let Some(mdc12) = system.mdc12.as_deref() {
+                    extra_roms.push(ExtraROMs::MDC12(mdc12));
+                    monitor = Some(options::monitor());
+                } else if let Some(toby) = system.toby.as_deref() {
+                    extra_roms.push(ExtraROMs::Toby(toby));
+                } else {
+                    bail!("The {} needs a Display Card 8-24 or Toby video card ROM", model);
+                }
+            }
+            _ => (),
+        }
+
+        let (mut emulator, frame_recv) = Emulator::new_with_extra(
+            rom,
+            &extra_roms,
+            model,
+            monitor,
+            MouseMode::default(),
+            None,
+            None,
+            false,
+            false,
+            None,
+            None,
+        )?;
+        let cmd = emulator.create_cmd_sender();
+        let events = emulator.create_event_recv();
+        emulator.set_step_batch(STEP_BATCH);
+
+        let audio = BufferAudioSink::default();
+        emulator.set_audio_provider(Arc::new(Mutex::new(BufferAudioProvider(audio.clone()))))?;
+
+        let mut floppy_game = false;
+        let ext = game_path
+            .extension()
+            .and_then(|e| e.to_str())
+            .map(str::to_ascii_lowercase)
+            .unwrap_or_default();
+        // Changes to disks stay in memory, so every start is from the unchanged images
+        if let Some(boot_disk) = &system.boot_disk {
+            emulator.load_hdd_image(boot_disk, 0)?;
+        }
+        if HDD_EXTENSIONS.contains(&ext.as_str()) || is_device_image(game_path) {
+            let scsi_id = if system.boot_disk.is_some() { 1 } else { 0 };
+            emulator.load_hdd_image(game_path, scsi_id)?;
+        } else if ARCHIVE_EXTENSIONS.contains(&ext.as_str()) {
+            let floppy = archive_floppy(game_path, model)?;
+            floppy_game = true;
+            cmd.send(EmulatorCommand::InsertFloppy(
+                0,
+                floppy.to_string_lossy().into_owned(),
+                true,
+            ))?;
+        } else if FLOPPY_EXTENSIONS.contains(&ext.as_str()) {
+            floppy_game = true;
+            cmd.send(EmulatorCommand::InsertFloppy(
+                0,
+                game_path.to_string_lossy().into_owned(),
+                false,
+            ))?;
+        } else {
+            bail!("Unsupported file type: {}", ext);
+        }
+
+        cmd.send(EmulatorCommand::Run)?;
+
+        Ok(Self {
+            emulator,
+            cmd,
+            events,
+            model,
+            frame_recv,
+            audio,
+            video_buf: Vec::new(),
+            audio_buf: Vec::new(),
+            width: 0,
+            height: 0,
+            mouse_button: false,
+            frames: 0,
+            // A Mac ejects a floppy it cannot start up from, then starts up from the hard disk
+            reinsert_floppy: floppy_game && system.boot_disk.is_some(),
+            pending_floppy: None,
+        })
+    }
+
+    fn run_frame(&mut self) -> Result<Option<DisplayBuffer>> {
+        self.frames = self.frames.saturating_add(1);
+        if let Some((delay, _)) = &mut self.pending_floppy {
+            if *delay > 0 {
+                *delay -= 1;
+            } else if let Some((_, insert)) = self.pending_floppy.take() {
+                info!("Reinserting the floppy ejected while starting up");
+                self.cmd.send(insert)?;
+            }
+        }
+
+        for _ in 0..MAX_TICKS_PER_RUN {
+            self.emulator.tick(1, ())?;
+            // Events queue up unbounded, so they are drained even when not needed
+            while let Ok(event) = self.events.try_recv() {
+                if let EmulatorEvent::FloppyEjected(drive, image) = event
+                    && self.reinsert_floppy
+                    && self.frames < BOOT_EJECT_WINDOW_FRAMES
+                {
+                    // Keeps the write protection of the ejected image
+                    let insert = EmulatorCommand::InsertFloppyImage(drive, image, false);
+                    self.pending_floppy = Some((REINSERT_DELAY_FRAMES, insert));
+                }
+            }
+            if let Some(frame) = self.frame_recv.lock().unwrap().take() {
+                return Ok(Some(frame));
+            }
+        }
+        Ok(None)
+    }
+
+    fn poll_input(&mut self) {
+        let Some(input_state) = CALLBACKS.get().input_state else {
+            return;
+        };
+
+        if self.width > 0 && self.height > 0 {
+            let px = unsafe { input_state(0, RETRO_DEVICE_POINTER, 0, RETRO_DEVICE_ID_POINTER_X) };
+            let py = unsafe { input_state(0, RETRO_DEVICE_POINTER, 0, RETRO_DEVICE_ID_POINTER_Y) };
+            let x = (i32::from(px) + 0x7fff) * self.width as i32 / 0xfffe;
+            let y = (i32::from(py) + 0x7fff) * self.height as i32 / 0xfffe;
+            let _ = self.cmd.send(EmulatorCommand::MouseUpdateAbsolute {
+                x: x.clamp(0, self.width as i32 - 1) as u16,
+                y: y.clamp(0, self.height as i32 - 1) as u16,
+            });
+        }
+
+        let button = unsafe { input_state(0, RETRO_DEVICE_MOUSE, 0, RETRO_DEVICE_ID_MOUSE_LEFT) } != 0;
+        if button != self.mouse_button {
+            self.mouse_button = button;
+            let _ = self.cmd.send(EmulatorCommand::MouseUpdateRelative {
+                relx: 0,
+                rely: 0,
+                btn: Some(button),
+            });
+        }
+    }
+
+    fn present(&mut self, frame: &DisplayBuffer) {
+        let (width, height) = (u32::from(frame.width()), u32::from(frame.height()));
+        if width == 0 || height == 0 {
+            return;
+        }
+        if (width, height) != (self.width, self.height) {
+            self.width = width;
+            self.height = height;
+            let mut geometry = geometry(width, height);
+            environment(RETRO_ENVIRONMENT_SET_GEOMETRY, (&raw mut geometry).cast());
+        }
+
+        self.video_buf.clear();
+        self.video_buf.extend(frame.chunks_exact(4).map(|p| {
+            (u32::from(p[0]) << 16) | (u32::from(p[1]) << 8) | u32::from(p[2])
+        }));
+        if let Some(video) = CALLBACKS.get().video {
+            unsafe {
+                video(self.video_buf.as_ptr().cast(), width, height, width as usize * 4);
+            }
+        }
+    }
+
+    fn flush_audio(&mut self) {
+        let samples = std::mem::take(&mut *self.audio.0.lock().unwrap());
+        self.audio_buf.clear();
+        self.audio_buf
+            .extend(samples.iter().map(|s| (s.clamp(-1.0, 1.0) * f32::from(i16::MAX)) as i16));
+        if let Some(audio_batch) = CALLBACKS.get().audio_batch {
+            let mut remaining = &self.audio_buf[..];
+            while remaining.len() >= 2 {
+                let written = unsafe { audio_batch(remaining.as_ptr(), remaining.len() / 2) };
+                if written == 0 {
+                    break;
+                }
+                remaining = &remaining[(written * 2).min(remaining.len())..];
+            }
+        }
+    }
+}
+
+fn geometry(width: u32, height: u32) -> RetroGameGeometry {
+    RetroGameGeometry {
+        base_width: width,
+        base_height: height,
+        max_width: MAX_WIDTH,
+        max_height: MAX_HEIGHT,
+        aspect_ratio: width as f32 / height as f32,
+    }
+}
+
+/// The ROMs for the main board and video, and a hard disk to boot from
+#[derive(Default)]
+struct SystemFiles {
+    main: Option<Vec<u8>>,
+    mdc12: Option<Vec<u8>>,
+    toby: Option<Vec<u8>>,
+    se30_video: Option<Vec<u8>>,
+    boot_disk: Option<PathBuf>,
+}
+
+impl SystemFiles {
+    /// Looks in the system directory, the root and next to the game, and in the folders
+    /// directly below those, so a zip of system files extracted into a folder is found too
+    fn find(game_path: &Path) -> Self {
+        let mut dirs = Vec::new();
+        let mut sysdir: *const c_char = std::ptr::null();
+        if environment(RETRO_ENVIRONMENT_GET_SYSTEM_DIRECTORY, (&raw mut sysdir).cast())
+            && !sysdir.is_null()
+        {
+            dirs.push(PathBuf::from(unsafe { CStr::from_ptr(sysdir) }.to_string_lossy().into_owned()));
+        }
+        dirs.push(PathBuf::from("/"));
+        if let Some(parent) = game_path.parent() {
+            dirs.push(parent.to_path_buf());
+        }
+
+        let mut files = Self::default();
+        for dir in dirs {
+            files.scan(&dir, 1, game_path);
+        }
+        files
+    }
+
+    fn scan(&mut self, dir: &Path, depth: usize, game_path: &Path) {
+        let Ok(entries) = std::fs::read_dir(dir) else {
+            return;
+        };
+        for entry in entries.flatten() {
+            let Ok(meta) = entry.metadata() else {
+                continue;
+            };
+            let path = entry.path();
+            if meta.is_dir() {
+                if depth > 0 {
+                    self.scan(&path, depth - 1, game_path);
+                }
+            } else if meta.is_file() && meta.len() <= MAX_ROM_SIZE {
+                if let Ok(data) = std::fs::read(&path) {
+                    self.add_rom(&path, data);
+                }
+            } else if meta.is_file()
+                && path != game_path
+                && self.boot_disk.is_none()
+                && is_device_image(&path)
+            {
+                info!("Using boot disk {}", path.display());
+                self.boot_disk = Some(path);
+            }
+        }
+    }
+
+    fn add_rom(&mut self, path: &Path, data: Vec<u8>) {
+        let slot = if MacModel::detect_from_rom(&data).is_some() {
+            &mut self.main
+        } else {
+            match format!("{:x}", Sha256::digest(&data)).as_str() {
+                MDC12_ROM_SHA256 => &mut self.mdc12,
+                TOBY_ROM_SHA256 => &mut self.toby,
+                SE30_VIDEO_ROM_SHA256 => &mut self.se30_video,
+                _ => return,
+            }
+        };
+        if slot.is_none() {
+            info!("Using ROM {}", path.display());
+            *slot = Some(data);
+        }
+    }
+}
+
+/// Puts a StuffIt archive on a write-protected floppy, to be expanded with StuffIt Expander
+fn archive_floppy(path: &Path, model: MacModel) -> Result<PathBuf> {
+    let data = std::fs::read(path)?;
+    let name = path.file_name().and_then(|n| n.to_str()).unwrap_or("Archive.sit");
+    let stem = path.file_stem().and_then(|n| n.to_str()).unwrap_or("Archive");
+    // StuffIt 5 archives have their own type, and need StuffIt Expander 5 or later
+    let file_type = if data.starts_with(b"StuffIt (c)1997") { *b"SITD" } else { *b"SIT!" };
+    let sectors = if model.fdd_hd() { 2880 } else { 1600 };
+    let file = hfs::HfsFile {
+        name,
+        file_type,
+        creator: *b"SIT!",
+        data: &data,
+    };
+    let image = hfs::build_floppy(stem, &file, sectors)?;
+    let floppy = std::env::temp_dir().join(format!("{stem}.img"));
+    std::fs::write(&floppy, image)?;
+    Ok(floppy)
+}
+
+/// Whether a file is an image of a whole SCSI disk, which starts with an Apple driver
+/// descriptor map. Floppy and partition images do not.
+fn is_device_image(path: &Path) -> bool {
+    let Ok(mut file) = std::fs::File::open(path) else {
+        return false;
+    };
+    let len = file.metadata().map_or(0, |m| m.len());
+    let mut signature = [0u8; 2];
+    len.is_multiple_of(512) && file.read_exact(&mut signature).is_ok() && &signature == b"ER"
+}
+
+/// Picks the model from the core option, or else from the ROMs
+fn select_model(rom: &[u8], system: &SystemFiles) -> Result<MacModel> {
+    let detected = MacModel::detect_from_rom(rom).ok_or_else(|| anyhow!("Unsupported ROM"))?;
+    // The SE/30 shares its ROM with the IIx and IIcx, so its video ROM tells them apart
+    let auto = if system.se30_video.is_some() && MacModel::SE30.is_valid_rom(rom) {
+        MacModel::SE30
+    } else {
+        detected
+    };
+    Ok(match options::model() {
+        Some(model) if model.is_valid_rom(rom) => model,
+        Some(model) => {
+            warn!("The ROM is not for the {}, using the {}", model, auto);
+            auto
+        }
+        None => auto,
+    })
+}
+
+struct RetroLogger;
+
+impl log::Log for RetroLogger {
+    fn enabled(&self, metadata: &log::Metadata) -> bool {
+        metadata.level() <= log::Level::Info
+    }
+
+    fn log(&self, record: &log::Record) {
+        if !self.enabled(record.metadata()) {
+            return;
+        }
+        let level = match record.level() {
+            log::Level::Error => RETRO_LOG_ERROR,
+            log::Level::Warn => RETRO_LOG_WARN,
+            log::Level::Info => RETRO_LOG_INFO,
+            _ => RETRO_LOG_DEBUG,
+        };
+        let Ok(msg) = CString::new(format!("[snow] {}\n", record.args())) else {
+            return;
+        };
+        match CALLBACKS.get().log {
+            Some(f) => unsafe { f(level, c"%s".as_ptr(), msg.as_ptr()) },
+            None => eprint!("{}", msg.to_string_lossy()),
+        }
+    }
+
+    fn flush(&self) {}
+}
+
+static LOGGER: RetroLogger = RetroLogger;
+
+extern "C" fn keyboard_event(down: bool, keycode: u32, _character: u32, _modifiers: u16) {
+    let Some(core) = CORE.get().as_mut() else {
+        return;
+    };
+    let Some(sc) = keymap::map_retrok(keycode) else {
+        return;
+    };
+    let event = if down {
+        KeyEvent::KeyDown(sc, Keymap::Universal)
+    } else {
+        KeyEvent::KeyUp(sc, Keymap::Universal)
+    };
+    let _ = core.cmd.send(EmulatorCommand::KeyEvent(event));
+}
