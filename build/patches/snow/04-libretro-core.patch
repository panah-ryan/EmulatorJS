+#[unsafe(no_mangle)]
+pub extern "C" fn retro_set_video_refresh(cb: RetroVideoRefreshFn) {
+    CALLBACKS.get().video = Some(cb);
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn retro_set_audio_sample(_cb: RetroAudioSampleFn) {}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn retro_set_audio_sample_batch(cb: RetroAudioSampleBatchFn) {
+    CALLBACKS.get().audio_batch = Some(cb);
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn retro_set_input_poll(cb: RetroInputPollFn) {
+    CALLBACKS.get().input_poll = Some(cb);
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn retro_set_input_state(cb: RetroInputStateFn) {
+    CALLBACKS.get().input_state = Some(cb);
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn retro_init() {
+    let mut log_cb = RetroLogCallback { log: None };
+    if environment(RETRO_ENVIRONMENT_GET_LOG_INTERFACE, (&raw mut log_cb).cast()) {
+        CALLBACKS.get().log = log_cb.log;
+    }
+    if log::set_logger(&LOGGER).is_ok() {
+        log::set_max_level(log::LevelFilter::Info);
+    }
+}
