--- /dev/null
+++ b/libretro/Makefile
@@ -0,0 +1,38 @@
+# Builds the core as a static archive for EmulatorJS's RetroArch link.
+# std is rebuilt with panic=abort so no wasm exception handling is needed,
+# and with atomics for the threaded builds.
+
+CARGO ?= $(shell command -v cargo 2>/dev/null || echo $(HOME)/.cargo/bin/cargo)
+RUSTUP ?= $(shell command -v rustup 2>/dev/null || echo $(HOME)/.cargo/bin/rustup)
+TARGET := wasm32-unknown-emscripten
+TOOLCHAIN := $(shell sed -n 's/^channel *= *"\(.*\)"/\1/p' ../rust-toolchain.toml)
+SETUP_HINT := rustup toolchain install $(TOOLCHAIN) --profile minimal --component rust-src --target $(TARGET)
+
+ifeq ($(EMULATORJS_THREADS),1)
+   TARGET_DIR := ../target/emulatorjs-threads
+   RUSTFLAGS_EXTRA := -C target-feature=+atomics,+bulk-memory
+else
+   TARGET_DIR := ../target/emulatorjs
+   RUSTFLAGS_EXTRA :=
+endif
+
+ARCHIVE := $(TARGET_DIR)/$(TARGET)/libretro/libsnow_libretro.a
+OUT := snow_libretro_emscripten.bc
+
+all: check-toolchain
+	RUSTC_BOOTSTRAP=1 RUSTFLAGS="$(RUSTFLAGS_EXTRA)" CARGO_TARGET_DIR=$(TARGET_DIR) \
+		$(CARGO) build -p snow_libretro --target $(TARGET) --profile libretro -Zbuild-std=std,panic_abort
+	cp $(ARCHIVE) $(OUT)
+
+check-toolchain:
+	@test -x "$(CARGO)" && test -x "$(RUSTUP)" || \
+		{ echo "error: Rust is not installed. Install rustup (https://rustup.rs), then run: $(SETUP_HINT)"; exit 1; }
+	@$(RUSTUP) component list --toolchain $(TOOLCHAIN) --installed 2>/dev/null | grep -q '^rust-src' || \
+		{ echo "error: Rust $(TOOLCHAIN) with rust-src is not installed. Run: $(SETUP_HINT)"; exit 1; }
+	@$(RUSTUP) target list --toolchain $(TOOLCHAIN) --installed 2>/dev/null | grep -qx '$(TARGET)' || \
+		{ echo "error: the $(TARGET) target is not installed for Rust $(TOOLCHAIN). Run: $(SETUP_HINT)"; exit 1; }
+
+clean:
+	rm -f $(OUT)
+
+.PHONY: all check-toolchain clean
