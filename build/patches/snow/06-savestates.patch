@@ -0,0 +1,172 @@
+//! Save states kept in memory, for hosts that store them themselves
+//!
+//! A state holds the whole machine, but of each SCSI disk only the blocks
+//! written since the image was attached. Restoring puts every other block
+//! back from the original image file.
+
+use std::collections::BTreeSet;
+use std::fs::File;
+use std::io::{Read, Seek, SeekFrom};
+use std::sync::{Arc, Mutex};
+
+use anyhow::{Context, Result, bail};
+use serde::{Deserialize, Serialize};
+
+use super::{Emulator, EmulatorConfig};
+use crate::mac::scsi::bus::ScsiBus;
+use crate::mac::scsi::disk::DISK_BLOCKSIZE;
+use crate::mac::scsi::disk_image::DiskImage;
+use crate::renderer::channel::ChannelRenderer;
+use crate::renderer::{DisplayBuffer, Renderer};
+
+const MAGIC: &[u8; 8] = b"SNOWMEM1";
+const ZSTD_LEVEL: i32 = 1;
+
+/// Blocks of a SCSI disk written since its image was attached
+#[derive(Serialize, Deserialize)]
+struct DiskChanges {
+    id: u8,
+    /// Size of the whole image, to catch a state made with another image
+    len: u64,
+    blocks: Vec<(u32, Vec<u8>)>,
+}
+
+#[derive(Serialize)]
+struct StateRef<'a> {
+    config: &'a EmulatorConfig,
+    disks: Vec<DiskChanges>,
+}
+
+#[derive(Deserialize)]
+struct StateOwned {
+    config: EmulatorConfig,
+    disks: Vec<DiskChanges>,
+}
+
+/// Reads blocks of the image file as it was before any writes
+fn read_original_blocks(image: &dyn DiskImage, blocks: &BTreeSet<u32>) -> Result<Vec<(u32, Vec<u8>)>> {
+    if blocks.is_empty() {
+        return Ok(Vec::new());
+    }
+    let path = image.image_path().context("Disk image has no file to restore from")?;
+    let mut file = File::open(path).with_context(|| format!("Failed to open {}", path.display()))?;
+    blocks
+        .iter()
+        .map(|&block| {
+            let mut data = vec![0; DISK_BLOCKSIZE];
+            file.seek(SeekFrom::Start(u64::from(block) * DISK_BLOCKSIZE as u64))?;
+            file.read_exact(&mut data)?;
+            Ok((block, data))
+        })
+        .collect()
+}
+
+impl Emulator {
+    /// Saves the machine state to a compressed buffer
+    pub fn save_state_to_vec(&self) -> Result<Vec<u8>> {
+        let mut disks = Vec::new();
+        for (id, target) in self.config.scsi().targets.iter().enumerate() {
+            let Some(target) = target else {
+                continue;
+            };
+            let (Some(image), Some(written)) = (target.disk_image(), target.written_blocks()) else {
+                bail!("SCSI ID #{} cannot be saved in a state", id);
+            };
+            let blocks = written
+                .iter()
+                .map(|&b| (b, image.read_bytes(b as usize * DISK_BLOCKSIZE, DISK_BLOCKSIZE)))
+                .collect();
+            disks.push(DiskChanges {
+                id: id as u8,
+                len: image.byte_len() as u64,
+                blocks,
+            });
+        }
+
+        let state = postcard::to_stdvec(&StateRef {
+            config: &self.config,
+            disks,
+        })?;
+        let compressed = zstd::bulk::compress(&state, ZSTD_LEVEL)?;
+        let mut out = MAGIC.to_vec();
+        out.extend(u32::try_from(compressed.len())?.to_le_bytes());
+        out.extend(compressed);
+        Ok(out)
+    }
+
+    /// Restores a state made by [`Self::save_state_to_vec`] into this emulator,
+    /// returning the new frame receiver. Anything after the state in `data` is ignored.
+    pub fn restore_state_from_slice(
+        &mut self,
+        data: &[u8],
+    ) -> Result<Arc<Mutex<Option<DisplayBuffer>>>> {
+        let Some((len, rest)) = data
+            .strip_prefix(MAGIC.as_slice())
+            .and_then(|d| d.split_first_chunk::<4>())
+        else {
+            bail!("Not a Snow state");
+        };
+        let Some(compressed) = rest.get(..u32::from_le_bytes(*len) as usize) else {
+            bail!("State is truncated");
+        };
+        let state = zstd::stream::decode_all(compressed)?;
+        let StateOwned { mut config, disks } = postcard::from_bytes(&state)?;
+
+        if config.model() != self.config.model() {
+            bail!("State is for a {}, not a {}", config.model(), self.config.model());
+        }
+
+        // Check everything, and read what is needed, before changing the running machine
+        let mut restores = Vec::new();
+        let mut originals = Vec::new();
+        for id in 0..ScsiBus::MAX_TARGETS {
+            let running = self.config.scsi().targets[id].as_ref();
+            let saved = config.scsi().targets[id].is_some();
+            let changes = disks.iter().find(|d| usize::from(d.id) == id);
+            match (running, saved, changes) {
+                (None, false, None) => continue,
+                (Some(target), true, Some(changes)) => {
+                    let (Some(image), Some(written)) = (target.disk_image(), target.written_blocks())
+                    else {
+                        bail!("SCSI ID #{} cannot be restored from a state", id);
+                    };
+                    if image.byte_len() as u64 != changes.len {
+                        bail!("SCSI ID #{} holds another disk image than the state", id);
+                    }
+                    let saved_set: BTreeSet<u32> = changes.blocks.iter().map(|(b, _)| *b).collect();
+                    let revert: BTreeSet<u32> = written.difference(&saved_set).copied().collect();
+                    originals.push(read_original_blocks(image, &revert)?);
+                    restores.push(id);
+                }
+                _ => bail!("SCSI ID #{} differs from the state", id),
+            }
+        }
+        for (id, original) in restores.into_iter().zip(originals) {
+            let mut image = self.config.scsi_mut().targets[id]
+                .as_mut()
+                .unwrap()
+                .take_image()
+                .context("SCSI disk has no image")?;
+            let changes = disks.iter().find(|d| usize::from(d.id) == id).unwrap();
+            for (block, data) in original.iter().chain(&changes.blocks) {
+                image.write_bytes(*block as usize * DISK_BLOCKSIZE, data);
+            }
+            let written = changes.blocks.iter().map(|(b, _)| *b).collect();
+            config.scsi_mut().targets[id]
+                .as_mut()
+                .unwrap()
+                .restore_image(image, written)?;
+        }
+
+        let renderer = ChannelRenderer::new(0, 0)?;
+        let frame_recv = renderer.get_receiver();
+        config.after_deserialize(renderer);
+        config.input_release_all();
+        self.config = config;
+        if let Some(provider) = self.audio_provider.clone() {
+            self.set_audio_provider(provider)?;
+        }
+        self.status_update()?;
+        Ok(frame_recv)
+    }
+}
