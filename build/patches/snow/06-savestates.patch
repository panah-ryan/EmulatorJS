+pub unsafe extern "C" fn retro_serialize(data: *mut c_void, size: usize) -> bool {
+    let Some(core) = CORE.get().as_mut() else {
+        return false;
+    };
+    let state = match core.state() {
+        Ok(state) => state,
+        Err(e) => {
+            error!("Failed to save state: {:?}", e);
+            return false;
+        }
+    };
+    if data.is_null() || size < state.len() {
+        return false;
+    }
+    let out = unsafe { std::slice::from_raw_parts_mut(data.cast::<u8>(), size) };
+    out[..state.len()].copy_from_slice(state);
+    out[state.len()..].fill(0);
+    true
 }
 
