Wraps a .sit archive in a generated HFS floppy image, so StuffIt archives can be
loaded directly and expanded inside the Mac.

diff --git a/libretro/src/hfs.rs b/libretro/src/hfs.rs
new file mode 100644
index 0000000..e835628
--- /dev/null
+++ b/libretro/src/hfs.rs
@@ -0,0 +1,315 @@
+//! Builds a floppy image holding a single file on an HFS volume, so files that are not disk
+//! images (such as StuffIt archives) can be inserted into the Mac.
+//!
+//! Layout, in 512-byte sectors: boot blocks (0-1), master directory block (2), volume bitmap (3),
+//! then allocation blocks holding the extents tree, the catalog tree and the file's data fork.
+//! The second to last sector holds a copy of the master directory block.
+
+use anyhow::{Result, bail};
+
+const SECTOR: usize = 512;
+const NODE_SIZE: usize = 512;
+
+const MDB_SECTOR: usize = 2;
+const BITMAP_SECTOR: usize = 3;
+const FIRST_ALLOC_SECTOR: usize = 4;
+
+const EXTENTS_NODES: usize = 4;
+const CATALOG_NODES: usize = 8;
+
+const ROOT_PARENT_ID: u32 = 1;
+const ROOT_DIR_ID: u32 = 2;
+const FIRST_FILE_ID: u32 = 16;
+
+/// Seconds from 1904 (the Mac epoch) to 1970
+const MAC_EPOCH_OFFSET: u64 = 2_082_844_800;
+
+pub struct HfsFile<'a> {
+    pub name: &'a str,
+    pub file_type: [u8; 4],
+    pub creator: [u8; 4],
+    pub data: &'a [u8],
+}
+
+/// Creates an image of `sectors` sectors (1600 for 800K, 2880 for 1.44MB)
+pub fn build_floppy(volume_name: &str, file: &HfsFile, sectors: usize) -> Result<Vec<u8>> {
+    let alloc_blocks = sectors - FIRST_ALLOC_SECTOR - 2;
+    let data_blocks = file.data.len().div_ceil(SECTOR);
+    let used = EXTENTS_NODES + CATALOG_NODES + data_blocks;
+    if used > alloc_blocks {
+        bail!(
+            "{} is too large for a {}K floppy",
+            file.name,
+            sectors * SECTOR / 1024
+        );
+    }
+
+    let now = mac_time_now();
+    let volume_name = mac_name(volume_name, 27);
+    let file_name = mac_name(file.name, 31);
+
+    let extents_start = 0;
+    let catalog_start = extents_start + EXTENTS_NODES;
+    let data_start = catalog_start + CATALOG_NODES;
+
+    let mut image = vec![0u8; sectors * SECTOR];
+
+    // Volume bitmap, one bit per allocation block, most significant bit first
+    let bitmap = &mut image[BITMAP_SECTOR * SECTOR..];
+    for block in 0..used {
+        bitmap[block / 8] |= 0x80 >> (block % 8);
+    }
+
+    let alloc = |block: usize| (FIRST_ALLOC_SECTOR + block) * SECTOR;
+
+    // Extents overflow tree, empty
+    image[alloc(extents_start)..alloc(extents_start) + NODE_SIZE]
+        .copy_from_slice(&header_node(0, 0, 0, 7, EXTENTS_NODES, 1));
+
+    // Catalog tree: one leaf node holding the root folder, its thread and the file
+    image[alloc(catalog_start)..alloc(catalog_start) + NODE_SIZE]
+        .copy_from_slice(&header_node(1, 1, 3, 37, CATALOG_NODES, 2));
+
+    let mut root = Vec::new();
+    push_u8(&mut root, 1); // directory record
+    push_u8(&mut root, 0);
+    push_u16(&mut root, 0); // flags
+    push_u16(&mut root, 1); // valence
+    push_u32(&mut root, ROOT_DIR_ID);
+    push_u32(&mut root, now); // created
+    push_u32(&mut root, now); // modified
+    push_u32(&mut root, 0); // backed up
+    root.extend_from_slice(&[0; 16 + 16 + 16]); // Finder info and reserved
+
+    let mut thread = Vec::new();
+    push_u8(&mut thread, 3); // directory thread record
+    push_u8(&mut thread, 0);
+    thread.extend_from_slice(&[0; 8]);
+    push_u32(&mut thread, ROOT_PARENT_ID);
+    thread.extend_from_slice(&str31(&volume_name));
+
+    let physical_len = (data_blocks * SECTOR) as u32;
+    let mut record = Vec::new();
+    push_u8(&mut record, 2); // file record
+    push_u8(&mut record, 0);
+    push_u8(&mut record, 0); // flags
+    push_u8(&mut record, 0); // version
+    record.extend_from_slice(&file.file_type);
+    record.extend_from_slice(&file.creator);
+    record.extend_from_slice(&[0; 8]); // Finder flags, location and folder
+    push_u32(&mut record, FIRST_FILE_ID);
+    push_u16(&mut record, 0); // first data block (unused)
+    push_u32(&mut record, file.data.len() as u32);
+    push_u32(&mut record, physical_len);
+    push_u16(&mut record, 0); // first resource block (unused)
+    push_u32(&mut record, 0); // resource fork lengths
+    push_u32(&mut record, 0);
+    push_u32(&mut record, now); // created
+    push_u32(&mut record, now); // modified
+    push_u32(&mut record, 0); // backed up
+    record.extend_from_slice(&[0; 16]); // extended Finder info
+    push_u16(&mut record, 0); // clump size
+    push_extents(&mut record, data_start, data_blocks);
+    push_extents(&mut record, 0, 0); // resource fork
+    push_u32(&mut record, 0);
+
+    let leaf = leaf_node(&[
+        (catalog_key(ROOT_PARENT_ID, &volume_name), root),
+        (catalog_key(ROOT_DIR_ID, b""), thread),
+        (catalog_key(ROOT_DIR_ID, &file_name), record),
+    ]);
+    image[alloc(catalog_start + 1)..alloc(catalog_start + 1) + NODE_SIZE].copy_from_slice(&leaf);
+
+    let data_offset = alloc(data_start);
+    image[data_offset..data_offset + file.data.len()].copy_from_slice(file.data);
+
+    let mut mdb = Vec::new();
+    push_u16(&mut mdb, 0x4244); // 'BD'
+    push_u32(&mut mdb, now); // created
+    push_u32(&mut mdb, now); // modified
+    push_u16(&mut mdb, 0x0100); // cleanly unmounted
+    push_u16(&mut mdb, 1); // files in the root folder
+    push_u16(&mut mdb, BITMAP_SECTOR as u16);
+    push_u16(&mut mdb, used as u16); // where to start allocating
+    push_u16(&mut mdb, alloc_blocks as u16);
+    push_u32(&mut mdb, SECTOR as u32); // allocation block size
+    push_u32(&mut mdb, 4 * SECTOR as u32); // clump size
+    push_u16(&mut mdb, FIRST_ALLOC_SECTOR as u16);
+    push_u32(&mut mdb, FIRST_FILE_ID + 1); // next catalog ID
+    push_u16(&mut mdb, (alloc_blocks - used) as u16);
+    mdb.extend_from_slice(&str_n(&volume_name, 28));
+    push_u32(&mut mdb, 0); // backed up
+    push_u16(&mut mdb, 0); // backup sequence
+    push_u32(&mut mdb, 0); // write count
+    push_u32(&mut mdb, (EXTENTS_NODES * NODE_SIZE) as u32); // extents clump size
+    push_u32(&mut mdb, (CATALOG_NODES * NODE_SIZE) as u32); // catalog clump size
+    push_u16(&mut mdb, 0); // folders in the root folder
+    push_u32(&mut mdb, 1); // files on the volume
+    push_u32(&mut mdb, 0); // folders on the volume, not counting the root
+    mdb.extend_from_slice(&[0; 32]); // Finder info
+    push_u16(&mut mdb, 0); // cache sizes
+    push_u16(&mut mdb, 0);
+    push_u16(&mut mdb, 0);
+    push_u32(&mut mdb, (EXTENTS_NODES * NODE_SIZE) as u32);
+    push_extents(&mut mdb, extents_start, EXTENTS_NODES);
+    push_u32(&mut mdb, (CATALOG_NODES * NODE_SIZE) as u32);
+    push_extents(&mut mdb, catalog_start, CATALOG_NODES);
+
+    image[MDB_SECTOR * SECTOR..MDB_SECTOR * SECTOR + mdb.len()].copy_from_slice(&mdb);
+    let alt_mdb = (sectors - 2) * SECTOR;
+    image[alt_mdb..alt_mdb + mdb.len()].copy_from_slice(&mdb);
+
+    Ok(image)
+}
+
+/// A B-tree header node for a tree whose nodes 0..`used_nodes` are in use
+fn header_node(
+    depth: u16,
+    root: u32,
+    leaf_records: u32,
+    max_key_len: u16,
+    total_nodes: usize,
+    used_nodes: usize,
+) -> Vec<u8> {
+    let mut node = vec![0u8; NODE_SIZE];
+    let mut desc = Vec::new();
+    push_u32(&mut desc, 0); // next node
+    push_u32(&mut desc, 0); // previous node
+    push_u8(&mut desc, 1); // header node
+    push_u8(&mut desc, 0); // height
+    push_u16(&mut desc, 3); // records
+    push_u16(&mut desc, 0);
+    node[..14].copy_from_slice(&desc);
+
+    let first_leaf = if leaf_records > 0 { root } else { 0 };
+    let mut header = Vec::new();
+    push_u16(&mut header, depth);
+    push_u32(&mut header, root);
+    push_u32(&mut header, leaf_records);
+    push_u32(&mut header, first_leaf);
+    push_u32(&mut header, first_leaf);
+    push_u16(&mut header, NODE_SIZE as u16);
+    push_u16(&mut header, max_key_len);
+    push_u32(&mut header, total_nodes as u32);
+    push_u32(&mut header, (total_nodes - used_nodes) as u32);
+    node[14..14 + header.len()].copy_from_slice(&header);
+
+    // The map record marks the nodes in use
+    for n in 0..used_nodes {
+        node[248 + n / 8] |= 0x80 >> (n % 8);
+    }
+
+    // Record offsets, from the end of the node: header, reserved, map, free space
+    for (i, offset) in [14u16, 120, 248, 504].iter().enumerate() {
+        node[NODE_SIZE - 2 * (i + 1)..NODE_SIZE - 2 * i].copy_from_slice(&offset.to_be_bytes());
+    }
+    node
+}
+
+fn leaf_node(records: &[(Vec<u8>, Vec<u8>)]) -> Vec<u8> {
+    let mut node = vec![0u8; NODE_SIZE];
+    node[8] = 0xFF; // leaf node
+    node[9] = 1; // height
+    node[10..12].copy_from_slice(&(records.len() as u16).to_be_bytes());
+
+    let mut offset = 14;
+    let mut offsets = vec![offset as u16];
+    for (key, data) in records {
+        node[offset..offset + key.len()].copy_from_slice(key);
+        offset += key.len();
+        node[offset..offset + data.len()].copy_from_slice(data);
+        offset += data.len();
+        offsets.push(offset as u16);
+    }
+    for (i, o) in offsets.iter().enumerate() {
+        node[NODE_SIZE - 2 * (i + 1)..NODE_SIZE - 2 * i].copy_from_slice(&o.to_be_bytes());
+    }
+    node
+}
+
+/// A catalog key, padded to an even length
+fn catalog_key(parent: u32, name: &[u8]) -> Vec<u8> {
+    let mut key = vec![(6 + name.len()) as u8, 0];
+    key.extend_from_slice(&parent.to_be_bytes());
+    key.push(name.len() as u8);
+    key.extend_from_slice(name);
+    if key.len() % 2 == 1 {
+        key.push(0);
+    }
+    key
+}
+
+fn push_extents(buf: &mut Vec<u8>, start: usize, count: usize) {
+    push_u16(buf, start as u16);
+    push_u16(buf, count as u16);
+    buf.extend_from_slice(&[0; 8]);
+}
+
+/// A Pascal string in a 32-byte field
+fn str31(name: &[u8]) -> [u8; 32] {
+    let mut s = [0u8; 32];
+    s[..str_n(name, 32).len()].copy_from_slice(&str_n(name, 32));
+    s
+}
+
+/// A Pascal string in a field of `size` bytes
+fn str_n(name: &[u8], size: usize) -> Vec<u8> {
+    let mut s = vec![0u8; size];
+    let len = name.len().min(size - 1);
+    s[0] = len as u8;
+    s[1..=len].copy_from_slice(&name[..len]);
+    s
+}
+
+/// A name the Mac accepts: printable ASCII without colons, at most `max` characters
+fn mac_name(name: &str, max: usize) -> Vec<u8> {
+    let name: Vec<u8> = name
+        .bytes()
+        .map(|b| match b {
+            b':' => b'-',
+            0x20..=0x7E => b,
+            _ => b'_',
+        })
+        .take(max)
+        .collect();
+    if name.is_empty() { b"Untitled".to_vec() } else { name }
+}
+
+fn mac_time_now() -> u32 {
+    let unix = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map_or(0, |d| d.as_secs());
+    (unix + MAC_EPOCH_OFFSET) as u32
+}
+
+fn push_u8(buf: &mut Vec<u8>, v: u8) {
+    buf.push(v);
+}
+
+fn push_u16(buf: &mut Vec<u8>, v: u16) {
+    buf.extend_from_slice(&v.to_be_bytes());
+}
+
+fn push_u32(buf: &mut Vec<u8>, v: u32) {
+    buf.extend_from_slice(&v.to_be_bytes());
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn record_sizes() {
+        assert_eq!(catalog_key(2, b"").len(), 8);
+        assert_eq!(catalog_key(2, b"a").len(), 8);
+        assert_eq!(catalog_key(2, b"ab").len(), 10);
+    }
+
+    #[test]
+    fn rejects_oversized_files() {
+        let data = vec![0u8; 900 * 1024];
+        let file = HfsFile { name: "big", file_type: *b"SIT!", creator: *b"SIT!", data: &data };
+        assert!(build_floppy("big", &file, 1600).is_err());
+        assert!(build_floppy("big", &file, 2880).is_ok());
+    }
+}
