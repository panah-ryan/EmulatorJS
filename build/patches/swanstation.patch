   g_ram_size = ram_size;
   m_ram_code_page_count = enable_8mb_ram ? RAM_8MB_CODE_PAGE_COUNT : RAM_2MB_CODE_PAGE_COUNT;
   return true;
+#endif
 }
 
 void ReleaseMemory()
 {
   if (g_ram)
   {
+#ifdef __EMSCRIPTEN__
+    std::free(g_ram);
+#else
     m_memory_arena.ReleaseViewPtr(g_ram, g_ram_size);
+#endif
     g_ram = nullptr;
     g_ram_mask = 0;
     g_ram_size = 0;
