diff --git a/libretro-common/libco/emscripten.c b/libretro-common/libco/emscripten.c
new file mode 100644
index 0000000..a39af94
--- /dev/null
+++ b/libretro-common/libco/emscripten.c
@@ -0,0 +1,79 @@
+/*
+  libco.emscripten
+  license: public domain
+*/
+
+#define LIBCO_C
+#include <libco.h>
+#include <stdlib.h>
+#include <emscripten/fiber.h>
+
+/* Asyncify saves the unwound call stack here while a fiber is switched out */
+#define ASYNCIFY_STACK_SIZE (128 * 1024)
+
+typedef struct
+{
+   emscripten_fiber_t fiber;
+   void *c_stack;
+   char asyncify_stack[ASYNCIFY_STACK_SIZE];
+} cothread_struct;
+
+static thread_local cothread_struct *co_primary = 0;
+static thread_local cothread_struct *co_running = 0;
+
+static void co_entry(void *entrypoint)
+{
+   ((void (*)(void))entrypoint)();
+}
+
+cothread_t co_active(void)
+{
+   if (!co_running)
+   {
+      co_primary = (cothread_struct*)calloc(1, sizeof(cothread_struct));
+      emscripten_fiber_init_from_current_context(&co_primary->fiber,
+            co_primary->asyncify_stack, ASYNCIFY_STACK_SIZE);
+      co_running = co_primary;
+   }
+   return (cothread_t)co_running;
+}
+
+cothread_t co_create(unsigned int size, void (*entrypoint)(void))
+{
+   cothread_struct *thread;
+
+   co_active();
+
+   thread = (cothread_struct*)calloc(1, sizeof(cothread_struct));
+   if (!thread)
+      return 0;
+
+   thread->c_stack = aligned_alloc(16, (size + 15) & ~15u);
+   if (!thread->c_stack)
+   {
+      free(thread);
+      return 0;
+   }
+
+   emscripten_fiber_init(&thread->fiber, co_entry, (void*)entrypoint,
+         thread->c_stack, size, thread->asyncify_stack, ASYNCIFY_STACK_SIZE);
+   return (cothread_t)thread;
+}
+
+void co_delete(cothread_t cothread)
+{
+   cothread_struct *thread = (cothread_struct*)cothread;
+
+   if (!thread || thread == co_primary)
+      return;
+   free(thread->c_stack);
+   free(thread);
+}
+
+void co_switch(cothread_t cothread)
+{
+   cothread_struct *previous = co_running;
+
+   co_running = (cothread_struct*)cothread;
+   emscripten_fiber_swap(&previous->fiber, &co_running->fiber);
+}
